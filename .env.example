# ── LLM provider ──────────────────────────────────────────────────────────────
# Any OpenAI-compatible API works: OpenAI, DeepSeek, Ollama (http://localhost:11434/v1), etc.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Set to "true" to bypass the LLM entirely and use deterministic rule-based
# mock responses — great for demos, CI, and the /admin dashboard smoke tests.
LLM_MOCK_MODE=false

# ── Catalog source ────────────────────────────────────────────────────────────
FAKESTORE_API_URL=https://fakestoreapi.com/products
CATALOG_CACHE_TTL_SECONDS=300

# ── Analytics logging (Path B "hackathon flex") ──────────────────────────────
# Accepted values: "" (off), "redis", "supabase"
ANALYTICS_BACKEND=
ANALYTICS_QUEUE_NAME=unmet_constraints

# Redis (when ANALYTICS_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0

# Supabase (when ANALYTICS_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_TABLE=unmet_constraints

# ── CORS (Next.js dev server) ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
